*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
.gitattributes text eol=lf

# 迁移原文按原字节归档，保留混合换行与原始摘要。
docs/roadmap/*.history-*.md -text whitespace=cr-at-eol,-blank-at-eol

# 自有发行源码按原字节入库，保持签名材料和构建源清单可重现。
# 编辑时沿文件既有格式；此处只关闭 Git 的隐式换行转换。
apps/** -text
connectors/** -text
packages/** -text
integrations/** -text
compat/** -text
config/** -text
scripts/** -text
tests/** -text
cmake/native/** -text
src/Guanheng*/** -text
src/TraderQMT/** -text
src/TraderQMTReadOnly/** -text
src/ReaderGuanhengRealtime/** -text
src/ParserQMTHostV6/** -text
# 公开原件样本保留末尾空格，保持原捕获字节及摘要。
tests/fixtures/observation/sgx/*.txt whitespace=-blank-at-eol
tests/fixtures/observation/legu-gdp/*.html whitespace=-blank-at-eol
tests/fixtures/observation/institutions/*.html whitespace=-blank-at-eol
tests/fixtures/observation/institutions/*.txt whitespace=-blank-at-eol
