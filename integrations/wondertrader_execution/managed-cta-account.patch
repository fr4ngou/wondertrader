+namespace {
+struct QueryOrderRelease { void operator()(WTSObject* value) const { if(value)value->release(); } };
+bool queryOrderCode(WTSOrderInfo* order,std::string& code)
+{
+	if(order==NULL || order->getContractInfo()==NULL || order->getContractInfo()->getCommInfo()==NULL)
+		return false;
+	WTSContractInfo* contract=order->getContractInfo();
+	WTSCommodityInfo* commodity=contract->getCommInfo();
+	if(commodity->getCategoty()==CC_FutOption || commodity->getCategoty()==CC_SpotOption)
+		code=CodeHelper::rawFutOptCodeToStdCode(contract->getCode(),contract->getExchg());
+	else if(CodeHelper::isMonthlyCode(contract->getCode()))
+		code=CodeHelper::rawMonthCodeToStdCode(contract->getCode(),contract->getExchg());
+	else
+		code=CodeHelper::rawFlatCodeToStdCode(contract->getCode(),contract->getExchg(),contract->getProduct());
+	return true;
+}
+void copyQueryOrderCounters(TradeStatInfo& to,const TradeStatInfo& from)
+{
+	// 仅替换完整ORDER查询拥有的字段；成交量、信息量及频率时间缓存保持原职责。
+	to.b_orders=from.b_orders;to.b_ordqty=from.b_ordqty;to.s_orders=from.s_orders;to.s_ordqty=from.s_ordqty;
+	to.b_cancels=from.b_cancels;to.b_canclqty=from.b_canclqty;to.s_cancels=from.s_cancels;to.s_canclqty=from.s_canclqty;
+	to.b_auto_cancels=from.b_auto_cancels;to.b_auto_canclqty=from.b_auto_canclqty;
+	to.s_auto_cancels=from.s_auto_cancels;to.s_auto_canclqty=from.s_auto_canclqty;
+	to.b_wrongs=from.b_wrongs;to.b_wrongqty=from.b_wrongqty;to.s_wrongs=from.s_wrongs;to.s_wrongqty=from.s_wrongqty;
+}
+}
+
+uint32_t TraderAdapter::queryOrderLocalId(const char* tag) const
+{
+	const std::string prefix=_order_pattern+".";
+	if(tag==NULL || strncmp(tag,prefix.c_str(),prefix.size())!=0)return 0;
+	tag+=prefix.size();if(!*tag)return 0;
+	uint32_t id=0;
+	for(;*tag;++tag)
+	{
+		if(*tag<'0'||*tag>'9'||id>((std::numeric_limits<uint32_t>::max)()-(*tag-'0'))/10)return 0;
+		id=id*10+(*tag-'0');
+	}
+	return id==(std::numeric_limits<uint32_t>::max)()?0:id;
+}
+
+bool TraderAdapter::applyQueryOrders(const WTSArray* rows)
+{
+	if(rows==NULL)return false;
+	std::unique_ptr<OrderMap,QueryOrderRelease> orders(OrderMap::create());
+	std::unique_ptr<TradeStatMap,QueryOrderRelease> statistics(TradeStatMap::create());
+	wt_hashmap<std::string,double> quantities;
+	auto orderids=_orderids;
+	const TradeStatInfo empty;
+	// 候选完全准备后统一发布。保留既有成交统计，重复完整查询只刷新订单字段。
+	if(_stat_map)
+	{
+		for(auto it=_stat_map->begin();it!=_stat_map->end();++it)
+		{
+			auto* old=(WTSTradeStateInfo*)it->second;
+			std::unique_ptr<WTSTradeStateInfo,QueryOrderRelease> copy(WTSTradeStateInfo::create(old->code()));
+			copy->statInfo()=old->statInfo();copyQueryOrderCounters(copy->statInfo(),empty);
+			statistics->add(old->code(),copy.get());
+		}
+	}
+	for(auto it=rows->begin();it!=rows->end();++it)
+	{
+		auto* row=dynamic_cast<WTSOrderInfo*>(*it);std::string code;
+		if(!queryOrderCode(row,code) || !std::isfinite(row->getVolLeft()) || row->getVolLeft()<0
+			|| !std::isfinite(row->getVolume()) || !std::isfinite(row->getVolTraded()))return false;
+		const bool buy=(row->getDirection()==WDT_LONG&&row->getOffsetType()==WOT_OPEN)
+			||(row->getDirection()==WDT_SHORT&&row->getOffsetType()!=WOT_OPEN);
+		auto* info=(WTSTradeStateInfo*)statistics->get(code.c_str());
+		if(info==NULL)
+		{
+			std::unique_ptr<WTSTradeStateInfo,QueryOrderRelease> next(WTSTradeStateInfo::create(code.c_str()));
+			statistics->add(code,next.get());info=next.get();
+		}
+		TradeStatInfo& item=info->statInfo();
+		if(buy){++item.b_orders;item.b_ordqty+=row->getVolume();}
+		else{++item.s_orders;item.s_ordqty+=row->getVolume();}
+		const double inactive=row->getVolume()-row->getVolTraded();
+		if(row->isError())
+		{
+			if(buy){++item.b_wrongs;item.b_wrongqty+=inactive;}else{++item.s_wrongs;item.s_wrongqty+=inactive;}
+		}
+		else if(row->getOrderState()==WOS_Canceled)
+		{
+			if(row->getOrderFlag()==WOF_NOR)
+			{
+				if(buy){++item.b_cancels;item.b_canclqty+=inactive;}else{++item.s_cancels;item.s_canclqty+=inactive;}
+			}
+			else if(buy){++item.b_auto_cancels;item.b_auto_canclqty+=inactive;}
+			else{++item.s_auto_cancels;item.s_auto_canclqty+=inactive;}
+		}
+		orderids.insert(row->getOrderID());
+		const uint32_t localid=queryOrderLocalId(row->getUserTag());
+		if(!row->isAlive() || !localid)continue;
+		if(orders->get(localid)!=NULL)return false;
+		orders->add(localid,row);quantities[code]+=row->getVolLeft()*(buy?1:-1);
+	}
+	{
+		SpinLock lock(_mtx_orders);
+		// 表、余量、订单统计一并换入；本模式仅由交易owner发布，锁内不通知策略/调用API。
+		OrderMap* old_orders=_orders;_orders=orders.release();orders.reset(old_orders);
+		TradeStatMap* old_stats=_stat_map;_stat_map=statistics.release();statistics.reset(old_stats);
+		_undone_qty.swap(quantities);_orderids.swap(orderids);
+	}
+	return true;
+}
+
+void TraderAdapter::pushQueryOrder(WTSOrderInfo* row)
+{
+	std::string code;if(!queryOrderCode(row,code))return;
+	const bool buy=(row->getDirection()==WDT_LONG&&row->getOffsetType()==WOT_OPEN)
+		||(row->getDirection()==WDT_SHORT&&row->getOffsetType()!=WOT_OPEN);
+	const uint32_t localid=queryOrderLocalId(row->getUserTag());
+	// 推送继续原通知/日志，完整查询单独更新原表；不将已查询的余量再按回报扣减。
+	if(localid)for(auto sink:_sinks)
+		sink->on_order(localid,code.c_str(),buy,row->getVolume(),row->getVolLeft(),row->getPrice(),row->getOrderState()==WOS_Canceled);
+	if(_save_data&&!row->isAlive())logOrder(localid,code.c_str(),row);
+	if(_notifier)_notifier->notify(id(),localid,code.c_str(),row);
+	_trader_api->queryOrders();refreshPositionObservation();
+}
