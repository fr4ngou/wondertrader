 #include "../Share/fmtlib.h"
+namespace {
+// 不新增事务协议；核对原同步文件API的真实返回，成功后才允许现有清空提交点继续。
+bool writer_file_ok(bool ok, const char* operation) {
+    if (!ok) throw std::runtime_error(std::string("Writer file operation failed: ") + operation);
+    return true;
+}
+bool writer_write(BoostFile& file, const void* data, std::size_t count) {
+    boost::interprocess::offset_t before = 0, after = 0, bytes = 0;
+    writer_file_ok(file.get_file_pointer(before), "write position");
+    writer_file_ok(file.write_file(data, count), "write");
+    writer_file_ok(file.get_file_pointer(after) && file.get_file_size(bytes), "written size");
+    if (before < 0 || after < before || static_cast<uint64_t>(after - before) != count || bytes < after)
+        throw std::runtime_error("Writer incomplete file write");
+    return true;
+}
+bool writer_write(BoostFile& file, const std::string& data) {
+    return writer_write(file, data.data(), data.size());
+}
+void writer_read_history(const char* filename, std::string& content) {
+    writer_file_ok(BoostFile::read_file_contents(filename, content), "read history");
+    // 原读helper内部长度为uint32；核实际文件长度，防止读取截断前缀却当完整历史覆盖。
+    if (BoostFile::get_file_size(filename) != content.size())
+        throw std::runtime_error("history read size mismatch");
+}
+struct DeferredLog { IDataWriterSink* sink; WTSLogLevel level; std::string text; };
+thread_local std::vector<DeferredLog>* writer_logs = nullptr;
+thread_local WtDataWriter* executing_writer = nullptr;
+thread_local WtDataWriter* mutation_writer = nullptr;
+struct WriterContext {
+    WtDataWriter* old;
+    explicit WriterContext(WtDataWriter* writer) : old(executing_writer) { executing_writer = writer; }
+    ~WriterContext() { executing_writer = old; }
+};
+struct MutationContext {
+    WtDataWriter* old;
+    explicit MutationContext(WtDataWriter* writer) : old(mutation_writer) { mutation_writer = writer; }
+    ~MutationContext() { mutation_writer = old; }
+};
+struct LogContext {
+    std::vector<DeferredLog> logs;
+    std::vector<DeferredLog>* old;
+    LogContext() : old(writer_logs) { writer_logs = &logs; }
+    ~LogContext() { writer_logs = old; }
+    void flush() {
+        auto records = std::move(logs);
+        // 回调重入拥有自己的上下文；本批内容在回调期间保持稳定。
+        for (auto& record : records) if (record.sink) {
+            try { record.sink->outputLog(record.level, record.text.c_str()); } catch (...) {}
+        }
+    }
+};
+}
