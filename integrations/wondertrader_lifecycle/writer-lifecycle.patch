+WtDataWriter::CallPermit::CallPermit(WtDataWriter& writer, bool read)
+    : _writer(writer), _read(read), _valid(false)
+{
+    std::lock_guard<std::mutex> state(writer._state_mutex);
+    _valid = read ? (writer._phase == Phase::Running || writer._phase == Phase::Closing)
+                  : (writer._phase == Phase::Running && !writer._fatal);
+    if (_valid) ++(read ? writer._read_calls : writer._write_calls);
+}
+WtDataWriter::CallPermit::~CallPermit()
+{
+    if (!_valid) return;
+    std::lock_guard<std::mutex> state(_writer._state_mutex);
+    --(_read ? _writer._read_calls : _writer._write_calls);
+    _writer._state_changed.notify_all();
+}
+bool WtDataWriter::copy_cached_tick(const std::string& key, WTSTickStruct& tick)
+{
+    SpinLock cache(_lck_tick_cache);
+    auto found = _tick_cache_idx.find(key);
+    if (!_tick_cache_block || found == _tick_cache_idx.end()) return false;
+    tick = _tick_cache_block->_ticks[found->second]._tick;
+    return true;
+}
+bool WtDataWriter::wait_turn(uint64_t ticket)
+{
+    std::unique_lock<std::mutex> state(_state_mutex);
+    _state_changed.wait(state, [this, ticket] { return _fatal || ticket == _serving_ticket; });
+    if (_fatal) { ++_cancelled; return false; }
+    return true;
+}
+void WtDataWriter::finish_turn(uint64_t ticket)
+{
+    std::lock_guard<std::mutex> state(_state_mutex);
+    if (!_fatal && ticket == _serving_ticket) ++_serving_ticket;
+    _state_changed.notify_all();
+}
+void WtDataWriter::fail_work(const char* reason) noexcept
+{
+    { std::lock_guard<std::mutex> state(_state_mutex);
+      _fatal = true; _checker_stop = true; _state_changed.notify_all(); }
+    try { pipe_writer_log(_sink, LL_ERROR, "Writer lifecycle task failed; pending work is cancelled: {}", reason); } catch (...) {}
+}
+bool WtDataWriter::submit_task(const TaskInfo& task)
+{
+    uint64_t ticket;
+    {
+        std::lock_guard<std::mutex> state(_state_mutex);
+        if (_fatal) return false;
+        ticket = _next_ticket;
+        if (_async_proc) {
+            if (!_task_thrd) _task_thrd.reset(new StdThread(&WtDataWriter::task_loop, this));
+            _tasks.emplace(ticket, task);
+        }
+        ++_next_ticket; _state_changed.notify_all();
+    }
+    if (_async_proc) return true;
+    return execute_task(ticket, task);
+}
+bool WtDataWriter::execute_task(uint64_t ticket, const TaskInfo& task)
+{
+    WriterContext context(this); LogContext logs;
+    if (!wait_turn(ticket)) return false;
+    bool processed = false;
+    bool completed = true;
+    try {
+        {
+            MutationContext mutation(this);
+            switch (task._type) {
+            case 0: processed = procTick(static_cast<WTSTickData*>(task._obj), task._flag); break;
+            case 1: processed = procQueue(static_cast<WTSOrdQueData*>(task._obj)); break;
+            case 2: processed = procOrder(static_cast<WTSOrdDtlData*>(task._obj)); break;
+            case 3: processed = procTrans(static_cast<WTSTransData*>(task._obj)); break;
+            default: throw std::logic_error("unknown Writer task");
+            }
+        }
+        finish_turn(ticket);
+        // 数据序号推进后，在原处理线程广播；同步广播重入获得新的存储序号。
+        if (processed) switch (task._type) {
+        case 0: _sink->broadcastTick(static_cast<WTSTickData*>(task._obj)); break;
+        case 1: _sink->broadcastOrdQue(static_cast<WTSOrdQueData*>(task._obj)); break;
+        case 2: _sink->broadcastOrdDtl(static_cast<WTSOrdDtlData*>(task._obj)); break;
+        case 3: _sink->broadcastTrans(static_cast<WTSTransData*>(task._obj)); break;
+        }
+    } catch (const std::exception& error) { completed = false; fail_work(error.what()); }
+      catch (...) { completed = false; fail_work("unknown exception"); }
+    logs.flush(); return completed;
+}
+void WtDataWriter::task_loop()
+{
+    WriterContext context(this);
+    try {
+    for (;;) {
+        std::unique_ptr<ScheduledTask> work;
+        {
+            std::unique_lock<std::mutex> state(_state_mutex);
+            _state_changed.wait(state, [this] { return _sealed || _fatal || !_tasks.empty(); });
+            if (_tasks.empty()) { if (_sealed || _fatal) return; continue; }
+            work.reset(new ScheduledTask(_tasks.front())); _tasks.pop();
+        }
+        execute_task(work->ticket, work->task);
+    }
+    } catch (const std::exception& error) { LogContext logs; fail_work(error.what()); logs.flush(); }
+      catch (...) { LogContext logs; fail_work("worker handoff exception"); logs.flush(); }
+}
+void WtDataWriter::transHisData(const char* sid)
+{
+    WriterContext context(this);
+    CallPermit call(*this);
+    if (!call || !sid) return;
+    ArchiveBatch batch;
+    if (strcmp(sid, CMD_CLEAR_CACHE) == 0) batch.commands.emplace_back(sid);
+    else {
+        CodeSet* source = _sink->getSessionComms(sid);
+        if (!source) return;
+        CodeSet comms(*source);
+        for (const auto& key : comms) {
+            const StringVector& parts = StrUtil::split(key, ".");
+            if (parts.size() < 2) continue;
+            WTSCommodityInfo* comm = _bd_mgr->getCommodity(parts[0].c_str(), parts[1].c_str());
+            if (!comm) continue;
+            for (const auto& code : comm->getCodes()) {
+                WTSContractInfo* ct = _bd_mgr->getContract(code.c_str(), parts[0].c_str());
+                if (ct) batch.commands.emplace_back(ct->getFullCode());
+            }
+        }
+        batch.commands.emplace_back(fmtutil::format("MARK.{}", sid));
+    }
+    std::lock_guard<std::mutex> state(_state_mutex);
+    if (_fatal) return;
+    if (!_proc_thrd) _proc_thrd.reset(new StdThread(&WtDataWriter::proc_loop, this));
+    batch.ticket = _next_ticket; _archive_jobs.push(std::move(batch));
+    ++_next_ticket; _checker_stop = true; _state_changed.notify_all();
+}
+void WtDataWriter::proc_loop()
+{
+    WriterContext context(this);
+    try {
+    for (;;) {
+        ArchiveBatch work;
+        {
+            std::unique_lock<std::mutex> state(_state_mutex);
+            _state_changed.wait(state, [this] { return _sealed || _fatal || !_archive_jobs.empty(); });
+            if (_archive_jobs.empty()) { if (_sealed || _fatal) return; continue; }
+            work = std::move(_archive_jobs.front()); _archive_jobs.pop();
+            // 观察checker真实退出，才能让归档回调离锁使用快照而不会被重新unmap。
+            _state_changed.wait(state, [this] { return _checker_exited || !_proc_chk; });
+        }
+        LogContext logs;
+        if (!wait_turn(work.ticket)) continue;
+        try {
+            { MutationContext mutation(this);
+              for (const auto& command : work.commands) archive_code(command); }
+            finish_turn(work.ticket);
+        } catch (const std::exception& error) { fail_work(error.what()); }
+          catch (...) { fail_work("unknown archive exception"); }
+        logs.flush();
+    }
+    } catch (const std::exception& error) { LogContext logs; fail_work(error.what()); logs.flush(); }
+      catch (...) { LogContext logs; fail_work("worker handoff exception"); logs.flush(); }
+}
+void WtDataWriter::mapping_expired(const char* prefix, const std::string& key)
+{
+    pipe_writer_log(_sink, LL_INFO, "{} {} mapping expired, automatically closed", prefix, key);
+}
+void WtDataWriter::check_loop()
+{
+    WriterContext context(this);
+    try {
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> state(_state_mutex);
+                if (_state_changed.wait_for(state, std::chrono::seconds(10), [this] { return _checker_stop; })) break;
+            }
+            LogContext logs;
+            const uint64_t now = TimeUtils::getLocalTimeNow() / 1000;
+            check_registry(_rt_ticks_blocks, now, "tick cache of"); check_registry(_rt_trans_blocks, now, "trans cache o");
+            check_registry(_rt_orddtl_blocks, now, "order cache of"); check_registry(_rt_ordque_blocks, now, "queue cache of");
+            check_registry(_rt_min1_blocks, now, "min1 cache of"); check_registry(_rt_min5_blocks, now, "min5 cache of");
+            logs.flush();
+        }
+    } catch (const std::exception& error) { LogContext logs; fail_work(error.what()); logs.flush(); }
+      catch (...) { LogContext logs; fail_work("unknown checker exception"); logs.flush(); }
+    { std::lock_guard<std::mutex> state(_state_mutex); _checker_exited = true; _state_changed.notify_all(); }
+}
+void WtDataWriter::close_mappings()
+{
+    close_registry(_rt_ticks_blocks); close_registry(_rt_trans_blocks);
+    close_registry(_rt_orddtl_blocks); close_registry(_rt_ordque_blocks);
+    close_registry(_rt_min1_blocks); close_registry(_rt_min5_blocks);
+}
+
+
+void WtDataWriter::clear_cache()
+{
+    // 当前归档序号排除了写者，缓存读者仅在复制/替换映射时短暂等待原缓存锁。
+    std::vector<std::pair<std::string, TickCacheItem>> snapshot;
+    {
+        SpinLock cache(_lck_tick_cache);
+        if (!_tick_cache_block) throw std::runtime_error("tick cache unavailable during clear");
+        for (const auto& entry : _tick_cache_idx)
+            snapshot.emplace_back(entry.first, _tick_cache_block->_ticks[entry.second]);
+    }
+    std::set<std::string> setCodes;
+    std::vector<std::string> expiredPaths;
+    std::stringstream ss_snapshot;
+    ss_snapshot << "date,exchg,code,open,high,low,close,settle,volume,turnover,openinterest,upperlimit,lowerlimit,preclose,presettle,preinterest" << std::endl << std::fixed;
+    for (const auto& entry : snapshot) {
+        const StringVector& parts = StrUtil::split(entry.first, ".");
+        WTSContractInfo* ct = _bd_mgr->getContract(parts[1].c_str(), parts[0].c_str());
+        if (ct) {
+            setCodes.insert(entry.first);
+            const WTSTickStruct& ts = entry.second._tick;
+            ss_snapshot << ts.trading_date << "," << ts.exchg << "," << ts.code << ","
+                << ts.open << "," << ts.high << "," << ts.low << "," << ts.price << ","
+                << ts.settle_price << "," << ts.total_volume << "," << ts.total_turnover << ","
+                << ts.open_interest << "," << ts.upper_limit << "," << ts.lower_limit << ","
+                << ts.pre_close << "," << ts.pre_settle << "," << ts.pre_interest << std::endl;
+        } else {
+            expiredPaths.push_back(fmtutil::format("{}rt/ticks/{}/{}.dmb", _base_dir, parts[0], parts[1]));
+            pipe_writer_log(_sink, LL_WARN, "{}[{}] expired, cache will be cleared", parts[1], parts[0]);
+        }
+    }
+    {
+        SpinLock cache(_lck_tick_cache);
+        if (setCodes.size() != _tick_cache_idx.size()) {
+            uint32_t diff = (uint32_t)(_tick_cache_idx.size() - setCodes.size());
+            uint32_t scale = (uint32_t)setCodes.size() / CACHE_SIZE_STEP;
+            if (setCodes.size() % CACHE_SIZE_STEP) ++scale;
+            uint32_t size = sizeof(RTTickCache) + sizeof(TickCacheItem) * scale * CACHE_SIZE_STEP;
+            std::string buffer(size, 0);
+            RTTickCache* newCache = reinterpret_cast<RTTickCache*>(&buffer[0]);
+            newCache->_capacity = scale * CACHE_SIZE_STEP;
+            newCache->_type = BT_RT_Cache; newCache->_size = (uint32_t)setCodes.size();
+            newCache->_version = BLOCK_VERSION_RAW_V2; strcpy(newCache->_blk_flag, BLK_FLAG);
+            wt_hashmap<std::string, uint32_t> newIdxMap;
+            uint32_t newIdx = 0;
+            for (const auto& key : setCodes) {
+                uint32_t oldIdx = _tick_cache_idx.find(key)->second;
+                newIdxMap[key] = newIdx;
+                memcpy(&newCache->_ticks[newIdx++], &_tick_cache_block->_ticks[oldIdx], sizeof(TickCacheItem));
+            }
+            _tick_cache_file->close(); _tick_cache_block = nullptr;
+            std::string filename = _base_dir + _cache_file;
+            BoostFile file;
+            if (!writer_file_ok(file.create_new_file(filename.c_str()), "create_new_file")) throw std::runtime_error("clear cache create failed");
+            writer_write(file, buffer.data(), buffer.size()); file.close_file();
+            if (!_tick_cache_file->map(filename.c_str())) throw std::runtime_error("clear cache remap failed");
+            _tick_cache_block = static_cast<RTTickCache*>(_tick_cache_file->addr());
+            _tick_cache_idx.swap(newIdxMap);
+            pipe_writer_log(_sink, LL_INFO, "{} expired cache cleared totally", diff);
+        }
+    }
+    // 关闭全部实时映射及tick日志，再移除原清理目录；保留pair身份供后续重新映射。
+    close_mappings();
+    for (const auto& path : expiredPaths) BoostFile::delete_file(path.c_str());
+    std::string path = fmtutil::format("{}his/snapshot/", _base_dir);
+    BoostFile::create_directories(path.c_str());
+    path += std::to_string(TimeUtils::getCurDate()) + ".csv";
+    BoostFile snapshotFile;
+    writer_file_ok(snapshotFile.create_new_file(path.c_str()), "create_new_file");
+    const std::string content = ss_snapshot.str();
+    writer_write(snapshotFile, content.data()); snapshotFile.close_file();
+    int try_count = 0;
+    do {
+        if (try_count >= 5) {
+            pipe_writer_log(_sink, LL_ERROR, "Too many trys to clear rt cache files, skip"); break;
+        }
+        ++try_count;
+        try {
+            for (const char* subdir : {"min1", "min5", "ticks", "orders", "queue", "trans"})
+                boost::filesystem::remove_all(boost::filesystem::path(fmtutil::format("{}rt/{}/", _base_dir, subdir)));
+            break;
+        } catch (...) {
+            pipe_writer_log(_sink, LL_ERROR, "Error occured while clearing rt cache files, retry in 300s");
+            std::this_thread::sleep_for(std::chrono::seconds(300));
+        }
+    } while (true);
+}
